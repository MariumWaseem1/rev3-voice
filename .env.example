# Copy to .env.local. Never commit values. Production: hosting secret manager.
APP_ORIGIN=http://localhost:3000
# Production under voice.rev3.uk/reception: set both to /reception before building.
NEXT_PUBLIC_BASE_PATH=
APP_BASE_PATH=
APP_MODE=simulation
DATABASE_URL=
# Embedded PostgreSQL is development/test ONLY. Live mode requires DATABASE_URL.
DEV_DATABASE_PATH=.data/rev3
DEV_AUTH_BYPASS=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Configure SMTP + an email OTP template in Supabase Auth, not in the browser.
# SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD, SMTP_SENDER are Supabase dashboard settings.
AUTH_SESSION_HOURS=12
ENTITLEMENT_HASH_SECRET=
INTERNAL_SERVICE_SECRET=
ADMIN_IDENTITIES=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_DEFAULT_TTS_VOICE=aura-2-thalia-en
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash
DEMO_ENABLED=false
# Set false to keep calls off while allowing previews with DEMO_ENABLED=true.
LIVE_CALLS_ENABLED=true
DEMO_TIMEOUT_SECONDS=180
RESERVATION_TIMEOUT_SECONDS=60
REJOIN_GRACE_SECONDS=30
GLOBAL_CONCURRENCY=5
MONTHLY_MINUTES=300
MONTHLY_ESTIMATED_BUDGET_GBP=100
ESTIMATED_COST_PER_MINUTE_GBP=0.30
ESTIMATED_PREVIEW_GBP=0.02
ESTIMATED_GENERATION_GBP=0.05
PREVIEW_LIMIT=20
PREVIEW_GLOBAL_DAILY_LIMIT=200
GENERATION_DAILY_LIMIT=5
RETENTION_DAYS=30
WORKER_BACKEND_URL=http://localhost:3000

# Temporary repeat calls on localhost only; ignored in production.
LOCAL_REPEAT_TESTS=false

# Combined Rev3 company site and invitation-only Studio
SITE_ROLE=studio
STUDIO_ORIGIN=https://voice.rev3.uk
STUDIO_INVITE_REQUIRED=true
RESEND_API_KEY=
RESEND_FROM_EMAIL=Rev3 <info@rev3.uk>
ENQUIRY_TO_EMAIL=info@rev3.uk
